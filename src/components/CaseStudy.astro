---
/**
 * Figma "Case Study / 01-04" (31:234 ...). Top rule, intro (index, title,
 * description), then the filmstrip gallery. No meta block (client / role / year) by decision.
 */
import Title from './Title.astro';
import Gallery from './Gallery.astro';
import type { CaseStudy } from '../data/work';
interface Props { study: CaseStudy; index: number; total: number }
const { study, index, total } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const titleId = `${study.slug}-title`;
---
<article class="case rule" id={study.slug} aria-labelledby={titleId}>
  <div class="row intro" data-case-intro>
    <p class="cell t-label-m c-tertiary index">{pad(index)} / {pad(total)}</p>
    <div class="main">
      <div class="title"><Title as="h3" size="m" text={study.title} id={titleId} /></div>
      <p class="cell t-body-l c-secondary description">{study.description}</p>
    </div>
  </div>
  <Gallery slides={study.slides} labelledBy={titleId} eager={index === 1} />
</article>

<style>
  .case {
    padding-bottom: var(--space-120);
    display: flex;
    flex-direction: column;
    --case-gap: var(--space-64);
    gap: var(--case-gap);
  }

  /* Top rule to gallery is as tall as the Work header (scripts/heads.ts sets --head-h) */
  .intro { min-height: calc(var(--head-h, 0px) - var(--case-gap)); }

  .main {
    grid-column: 2 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .title { padding: var(--space-16) var(--space-16) 0; }

  /* Description spans columns 2-3, text max 600 */
  .description {
    width: calc(200% / 3);
    max-width: 632px; /* 600 text + 2 x 16 inset */
  }

  @media (max-width: 1023px) {
    .index, .main { grid-column: 1 / -1; }
    .index { padding-bottom: 0; }
    .description { width: 100%; max-width: 632px; }
  }

  @media (max-width: 767px) {
    .case { padding-bottom: var(--space-64); --case-gap: var(--space-40); }
  }
</style>
