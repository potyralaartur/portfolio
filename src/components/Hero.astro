---
/** Figma "Hero" (31:181): masthead row, sprayed tag, meta row, 4 x n field grid behind the tag. */
import InfoBlock from './InfoBlock.astro';
import Tag from './Tag.astro';
import { masthead, heroMeta, person } from '../data/site';
---
<header class="hero" data-hero>
  <h1 class="visually-hidden">{person.name}, {person.role}</h1>

  <nav class="row masthead" aria-label="Site">
    {masthead.map((block) => <InfoBlock {...block} />)}
  </nav>

  <!-- Figma "Grid / 4 × 8 fields" (31:197): before the stage, so the paint covers the rules -->
  <div class="fields" aria-hidden="true"></div>

  <div class="stage">
    <Tag />
  </div>

  <div class="row meta t-label-m">
    <p class="cell c-secondary">{heroMeta.coordinates}</p>
    <p class="cell c-secondary edition"><span class="dot" aria-hidden="true"></span>{heroMeta.edition}</p>
    <div class="cell" aria-hidden="true"></div>
    <p class="cell scroll">
      <a class="c-secondary" href="#work">{heroMeta.scroll} <span class="t-body-m arrow" aria-hidden="true">↓</span></a>
    </p>
  </div>
</header>

<!-- Inline, right after the hero: the row count is set before the first paint, so rows never jump -->
<script is:inline>
  (() => {
    const hero = document.querySelector('[data-hero]');
    if (!hero) return;
    const min = parseFloat(getComputedStyle(hero).getPropertyValue('--grid-row')) || 120;
    const fit = () => hero.style.setProperty('--hero-rows', String(Math.max(3, Math.floor(hero.clientHeight / min))));
    fit();
    addEventListener('resize', fit); // the hero is one screen tall, so only a viewport resize changes it
  })();
</script>

<style>
  .hero {
    position: relative; /* for .fields */
    /* Opaque so the page column rules underneath don't double up with .fields */
    background: var(--bg-base);
    /* Always exactly one screen (svh: the visible height with mobile browser bars shown, stable while scrolling) */
    height: 100svh;
    display: flex;
    flex-direction: column;
    /*
     * n equal rows: as many as fit at least 120 tall (the masthead needs 116),
     * so 8 x 120 at 1440 x 960 like in Figma, 6 x 130 at 780, 11 x 120 at 1324.
     * The inline script below sets --hero-rows from the hero's height. Whole
     * pixels keep the lines crisp; the meta row takes the < n px left over.
     */
    --hero-row: round(down, calc(100svh / var(--hero-rows, 8)), 1px);
  }

  /*
   * Column rules (full height) and row rules. The masthead takes the top row
   * (two on tablets, where its blocks wrap), the meta row the bottom one, and
   * the tag area between them is ruled every --hero-row down to the meta row.
   */
  .fields {
    position: absolute;
    inset: 0;
    pointer-events: none; /* no z-index: the tag (positioned, later in the DOM) paints over it */
  }
  .fields::before,
  .fields::after {
    content: '';
    position: absolute;
  }
  .fields::before {
    inset: 0 calc(var(--grid-margin) - 1px) 0 var(--grid-margin);
    border-right: 1px solid var(--line-grid);
    background: linear-gradient(to right, var(--line-grid) 1px, transparent 1px) 0 0 /
      calc(100% / var(--grid-columns)) 1px repeat; /* 1px tile: see .page-grid */
    background-clip: padding-box; /* keep the last tile out from under the border */
  }
  .fields::after {
    /* Exactly n - 2 whole rows, so the leftover pixels fall below the meta line */
    inset: var(--hero-row) var(--grid-margin) auto;
    height: calc(var(--hero-row) * (var(--hero-rows, 8) - 2));
    box-shadow: 0 1px 0 var(--line-grid); /* the line on top of the meta row */
    background: linear-gradient(to bottom, var(--line-grid) 1px, transparent 1px) 0 0 / 100% var(--hero-row) repeat-y;
  }

  /* Each line of info blocks is one row (tablets wrap the four blocks onto two) */
  .masthead {
    grid-auto-rows: minmax(var(--hero-row), auto);
    align-items: start;
  }

  /*
   * Tag stage: whatever the masthead and meta rows leave. The 1392 x 720 tag
   * fits it: as wide as the margins allow, unless the height runs out first.
   */
  .stage {
    flex: 1;
    min-height: 0;
    container-type: size;
    display: flex;
    align-items: center;
    padding-inline: var(--grid-margin);
  }
  .stage :global(.tag) {
    width: min(100cqw, 100cqh * 1392 / 720);
    margin-inline: auto;
  }

  .meta {
    height: var(--hero-row);
    align-items: end;
  }

  .edition {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-signal);
    flex: none;
  }

  .scroll {
    justify-self: end;
    display: flex;
    align-items: flex-end;
  }

  .scroll a {
    display: inline-flex;
    align-items: flex-end;
    gap: var(--space-8);
  }

  .scroll a:hover { color: var(--text-primary); }

  .arrow {
    display: inline-block;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .scroll a:hover .arrow { transform: translateY(2px); }

  @media (max-width: 1023px) {
    .meta p:nth-child(3) { display: none; }
    .meta { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /*
   * Phones, and short screens (a phone on its side): name + contact side by
   * side and a slim meta row, so the one-screen hero leaves the tag room
   */
  @media (max-width: 767px), (max-height: 560px) {
    .fields::after { display: none; } /* no room for 120px rows: column rules only */
    .masthead { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: auto; }
    .masthead > :global(:nth-child(2)),
    .masthead > :global(:nth-child(3)) { display: none; }
    /* Trim the empty band of the 1392 x 720 viewBox (paint sits at y ~100-690); % margins follow width */
    .stage :global(.tag) { margin-block: -7% -2%; }
    .meta { grid-template-columns: 1fr auto; height: auto; }
    .meta p:nth-child(2) { display: none; }
  }
</style>
