---
/** Figma "Work / Header" (31:228) */
import Title from './Title.astro';
import { workHeader } from '../data/site';
---
<div class="row work-header rule">
  <p class="cell t-label-m c-secondary label">{workHeader.label}</p>
  <div class="cell main">
    <Title as="h2" size="l" text={workHeader.title} />
    <p class="t-body-l c-secondary intro">{workHeader.intro}</p>
  </div>
</div>

<style>
  .main {
    grid-column: 2 / -1;
    padding-bottom: var(--space-64);
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  .intro { max-width: 316px; }

  @media (max-width: 1023px) {
    .label, .main { grid-column: 1 / -1; }
    .label { padding-bottom: 0; }
  }
</style>
