---
/** Figma "About" (31:388): label, statement (cols 2-3), portrait 3:4 (col 4), four facts. */
import InfoBlock from './InfoBlock.astro';
import { about } from '../data/site';
---
<section class="about" id="about" aria-labelledby="about-title">
  <div class="row statement-row rule">
    <p class="cell t-label-m c-secondary label">{about.label}</p>
    <h2 id="about-title" class="visually-hidden">About</h2>
    <p class="cell t-heading-m c-primary statement">{about.statement}</p>
    <div class="portrait">
      {about.portrait ? (
        <img src={about.portrait.src} alt={about.portrait.alt} width="348" height="464" loading="lazy" />
      ) : (
        <span class="t-label-m c-tertiary" aria-hidden="true">Portrait 3:4</span>
      )}
    </div>
  </div>
  <div class="row facts rule">
    {about.facts.map((f) => <InfoBlock {...f} />)}
  </div>
</section>

<style>
  .statement { grid-column: 2 / 4; padding-bottom: var(--space-64); }

  .portrait {
    grid-column: 4;
    aspect-ratio: 3 / 4;
    background: var(--bg-raised);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .portrait img { width: 100%; height: 100%; object-fit: cover; }

  .facts { padding-bottom: var(--space-120); }

  @media (max-width: 1023px) {
    .label, .statement { grid-column: 1 / -1; }
    .label { padding-bottom: 0; }
    .portrait { grid-column: 1; margin: 0 var(--space-16) var(--space-40); }
  }
</style>
